{{>layout_head}}<h1>Register</h1>{{#error}}<p class="err">{{error}}</p>{{/error}}
<form method="post" action="/register"><input type="hidden" name="csrf" value="{{csrf}}">
<label>Username <input name="username" value="{{old.username}}" required></label>
<label>Email <input type="email" name="email" value="{{old.email}}" required></label>
<label>Password (min 8) <input type="password" name="password" required minlength="8"></label><button>Create account</button></form>{{>layout_foot}}
